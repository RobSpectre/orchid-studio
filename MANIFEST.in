include README.md AGENTS.md .gitignore LICENSE THIRD_PARTY.md CONTRIBUTING.md
recursive-include src/orchid_studio *.swift *.html *.css *.js *.json
recursive-include docs *.md
recursive-include scripts *.py *.sh *.yml
